          "expr": "histogram_quantile(0.5, sum by (le) (rate(leafguard_prediction_confidence_bucket[5m])))",
          "legendFormat": "median confidence",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(leafguard_low_confidence_total[5m])) / clamp_min(sum(rate(leafguard_predictions_total[5m])),1e-9)",
